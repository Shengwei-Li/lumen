<Window x:Class="Lumen.Countdown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumen" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight"
        Background="{StaticResource Ink}" FontFamily="{StaticResource Sans}"
        UseLayoutRounding="True">
    <Grid Width="168" Height="168">
        <TextBlock x:Name="Num" Text="3" FontFamily="{StaticResource Mono}" FontSize="76"
                   Foreground="{StaticResource Paper}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,-6,0,0"/>
    </Grid>
</Window>
